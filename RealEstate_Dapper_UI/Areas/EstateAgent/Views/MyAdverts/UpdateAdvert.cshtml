@model UpdateProductDto
@{
    ViewData["Title"] = "UpdateAdvert";
    Layout = "~/Areas/EstateAgent/Views/LayoutEstateAgent/Index.cshtml";
}


<div class="container-fluid pt-4 px-4">
    <div class="row g-4">
        <div class="col-12">
            <div class="bg-light rounded h-100 p-4">
                <h6 class="mb-4">İlan Güncelleme Sayfası</h6>
                
                <form method="post" asp-area="EstateAgent" asp-controller="MyAdverts" asp-action="UpdateAdvert">
                    <input type="hidden" asp-for="ProductID" />

                    <div class="form-group mb-3">
                        <label>İlan Başlığı</label>
                        <input type="text" asp-for="Title" class="form-control" />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label>Fiyat</label>
                            <input type="text" asp-for="Price" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label>İlan Tipi (Satılık/Kiralık)</label>
                            <input type="text" asp-for="Type" class="form-control" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label>Şehir Adı</label>
                            <input type="text" asp-for="CityName" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label>İlçe</label>
                            <input type="text" asp-for="District" class="form-control" />
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label>Adres</label>
                        <textarea asp-for="Adress" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="form-group mb-3">
                        <label>Kapak Fotoğrafı URL</label>
                        <input type="text" asp-for="CoverImage" class="form-control" />
                    </div>
                    <h3>@ViewBag.Error</h3>
                    <button class="btn btn-success">Değişiklikleri Kaydet</button>
                </form>
            </div>
        </div>
    </div>
</div>