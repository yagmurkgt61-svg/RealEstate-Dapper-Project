@model RealEstate_Dapper_UI.Dtos.CategoriesdbDtos.UpdateCategoriesdbDto

@{
    ViewData["Title"] = "Kategori Güncelle";
    Layout = "~/Views/Shared/_DataTablesLayout.cshtml";
}

<h2 style="margin-top: 0; margin-bottom: 25px; color: #ffffff;">Kategori Güncelle</h2>

<form action="/Categories/UpdateCategories" method="post">

    <input type="hidden" name="CategoryID" value="@Model?.CategoryID" />

    <div class="dt-form-group">
        <label for="CategoryName">Kategori Adı</label>
        <input type="text"
               id="CategoryName"
               name="CategoryName"
               value="@Model?.CategoryName"
               class="dt-input"
               placeholder="Kategori adını giriniz..."
               required />
    </div>

    <div class="dt-form-group">
        <label for="Order">Görüntülenme Sırası</label>
        <input type="number"
               id="Order"
               name="Order"
               value="@Model?.Order"
               class="dt-input"
               placeholder="Örn: 1, 2, 3..."
               required />
    </div>

    <div class="dt-checkbox-group">
        <input type="checkbox" id="IsActive" name="IsActive" value="true" class="dt-checkbox" @(Model?.IsActive == true ? "checked" : "") />
        <label for="IsActive" style="margin-bottom: 0; user-select: none; cursor: pointer;">Bu kategori sitede aktif olarak görüntülensin.</label>
        <input type="hidden" name="IsActive" value="false" />
    </div>

    <div style="margin-top: 30px; display: flex; gap: 10px;">
        <button type="submit" class="dt-btn dt-btn-warning" style="font-size: 14px; padding: 10px 20px;">
            🔄 Değişiklikleri Kaydet
        </button>
        
        <a href="/Categories/Index" class="dt-btn" style="background-color: #444; color: #fff; font-size: 14px; padding: 10px 20px;">
            ❌ İptal Et / Listeye Dön
        </a>
    </div>
</form>