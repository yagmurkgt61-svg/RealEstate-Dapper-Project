@model RealEstate_Dapper_UI.Dtos.CategoriesdbDtos.CreateCategoriesdbDto

@{
    ViewData["Title"] = "CreateCategories";
    Layout = "~/Views/Shared/_DataTablesLayout.cshtml";
}

<style>
    /* Sayfa genelinde kaçak alt çizgileri ve hover durumlarını engeller */
    .dt-btn, a.dt-btn, button {
        text-decoration: none !important;
        background-color: #00ff66;
    }

        a.dt-btn:hover, a.dt-btn:focus {
            text-decoration: none !important;
            opacity: 0.85; /* Üzerine gelince şık bir sönme efekti */
            transition: all 0.2s ease;
        }
</style>

<h2 style="margin-top: 0; margin-bottom: 25px; color: #ffffff;">Yeni Kategori Ekle</h2>

<form action="/Categories/CreateCategories" method="post">
    <div class="dt-form-group">
        <label for="CategoryName">Kategori Adı</label>
        <input type="text" id="CategoryName" name="CategoryName" class="dt-input" placeholder="Örn: Mobilya, Aksesuar, Elektronik..." required />
    </div>

    <div class="dt-form-group">
        <label for="Order">Görüntülenme Sırası</label>
        <input type="number" id="Order" name="Order" class="dt-input" placeholder="Örn: 1, 2, 3..." required />
    </div>

    <div class="dt-checkbox-group">
        <input type="checkbox" id="IsActive" name="IsActive" value="true" class="dt-checkbox" checked />
        <label for="IsActive" style="margin-bottom: 0; user-select: none; cursor: pointer;">Bu kategori sitede aktif olarak görüntülensin.</label>
        <input type="hidden" name="IsActive" value="false" />
    </div>

    <div style="margin-top: 30px; display: flex; gap: 10px;">
        <button type="submit" class="dt-btn dt-btn-success" style="font-size: 14px; padding: 10px 20px; text-decoration: none !important;">
            💾 Kategoriyi Kaydet
        </button>

        <a href="/Categories/Index" class="dt-btn" style="background-color: #444; color: #fff; font-size: 14px; padding: 10px 20px; text-decoration: none !important;">
            ❌ İptal Et / Listeye Dön
        </a>
    </div>
</form>