@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link href="~/DataTables/datatables.min.css" rel="stylesheet" />

    <style>
            /* DataTables web sitesinin orijinal mavi arka plan rengi */
            body {
                background-color: #337ab7;
                color: #ffffff;
                font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
                margin: 0;
                padding: 0;
            }

            /* Ana içerik taşıyıcı alan (Üst boşluğu biraz artırdık) */
            .main-wrapper {
                max-width: 1200px;
                margin: 0 auto;
                padding: 50px 15px 60px 15px;
            }

            /* Büyük beyaz başlık stili */
            .main-title {
                font-size: 42px;
                font-weight: 700;
                margin-top: 10px;
                margin-bottom: 5px;
                line-height: 1.2;
            }

                .main-title em {
                    font-style: italic;
                    font-weight: 400;
                    color: rgba(255, 255, 255, 0.9);
                }

            /* Tablonun içine oturduğu o koyu renkli panel */
            .dt-demo-panel {
                background-color: #1b1c1d;
                border-radius: 6px;
                padding: 25px;
                margin-top: 30px;
                box-shadow: 0 6px 18px rgba(0,0,0,0.4);
            }

            /* Panel içindeki DataTables yazılarını ve girdilerini beyaza uyarlama */
            .dt-length, .dt-search, .dt-info, .dt-paging {
                color: #b5b5b5 !important;
                font-size: 14px;
            }

                .dt-search input {
                    background-color: #2b2c2d !important;
                    color: #ffffff !important;
                    border: 1px solid #444 !important;
                    border-radius: 4px;
                    padding: 5px 10px;
                    margin-left: 8px;
                }

                .dt-length select {
                    background-color: #2b2c2d !important;
                    color: #ffffff !important;
                    border: 1px solid #444 !important;
                    border-radius: 4px;
                    padding: 3px;
                }
            /* Ortak Buton Tasarımı */
            .dt-btn {
                display: inline-block;
                padding: 6px 14px;
                font-size: 13px;
                font-weight: 600;
                line-height: 1.42857143;
                text-align: center;
                white-space: nowrap;
                vertical-align: middle;
                cursor: pointer;
                border: none;
                border-radius: 4px;
                text-decoration: none;
                transition: all 0.2s ease;
            }

            /* Yeni Kategori Ekle (Yeşil Buton) */
            .dt-btn-success {
                background-color: #28a745;
                color: #ffffff !important;
            }

                .dt-btn-success:hover {
                    background-color: #218838;
                }

            /* Sil (Kırmızı Buton) */
            .dt-btn-danger {
                background-color: #cb2431;
                color: #ffffff !important;
            }

                .dt-btn-danger:hover {
                    background-color: #b11f2a;
                }

            /* Güncelle (Turuncu/Sarı Buton) */
            .dt-btn-warning {
                background-color: #e09400;
                color: #ffffff !important;
            }

                .dt-btn-warning:hover {
                    background-color: #c48200;
                }
            /* Form Alanı Düzeni */
            .dt-form-group {
                margin-bottom: 20px;
            }

                .dt-form-group label {
                    display: block;
                    margin-bottom: 8px;
                    font-size: 14px;
                    color: #b5b5b5;
                    font-weight: 600;
                }

            /* Koyu Temalı Input Tasarımı */
            .dt-input {
                width: 100%;
                padding: 10px 12px;
                background-color: #2b2c2d !important;
                color: #ffffff !important;
                border: 1px solid #444 !important;
                border-radius: 4px;
                font-size: 14px;
                box-sizing: border-box;
                transition: border-color 0.2s ease;
            }

                .dt-input:focus {
                    border-color: #337ab7 !important;
                    outline: none;
                }

            /* Checkbox (Aktif mi?) Düzeni */
            .dt-checkbox-group {
                display: flex;
                align-items: center;
                gap: 10px;
                margin-bottom: 20px;
                cursor: pointer;
            }

            .dt-checkbox {
                width: 18px;
                height: 18px;
                cursor: pointer;
            }
    </style>
</head>
<body>

    <div class="main-wrapper">
        
        <div class="dt-demo-panel">
            @RenderBody()
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="~/DataTables/datatables.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>