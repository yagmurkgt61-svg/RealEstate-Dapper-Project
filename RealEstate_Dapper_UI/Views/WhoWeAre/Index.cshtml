@model List<ResultWhoWeAreDetailDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Admin/Index.cshtml";
    int count = 0;
}
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="container-fluid pt-4 px-4">
    <div class="row g-4">
        <div class="col-12">
            <div class="bg-light rounded h-100 p-4">
                <h6 class="mb-4">Biz Kimiz Listesi</h6>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th scope="col">#</th>
                                <th scope="col">Başlık</th>
                                <th scope="col">Alt Başlık</th>
                                <th scope="col">Sil</th>
                                <th scope="col">Güncelle</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                count++;
                                <tr>
                                    <th scope="row">@count</th>
                                    <td>@item.Title</td>
                                    <td>@item.SubTitle</td>
                                    <td>
                                        <button onclick="deleteWhoWeAre(@item.WhoWeAreDetailID)" class="btn btn-outline-danger">Sil</button>
                                    </td>
                                    <td><a href="/WhoWeAre/UpdateWhoWeAreDetail/@item.WhoWeAreDetailID" class="btn btn-outline-success">Güncelle</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <a href="/WhoWeAre/CreateWhoWeAreDetail" class="btn btn-outline-info">Yeni Biz Kimiz Alanı Girişi</a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function deleteWhoWeAre(id) {
Swal.fire({
title: 'Emin misiniz?',
text: "Bu içeriği silmek istediğinize emin misiniz? Bu işlem geri alınamaz!",
icon: 'warning',
showCancelButton: true,
confirmButtonColor: '#d33',
cancelButtonColor: '#3085d6',
confirmButtonText: 'Evet, Sil!',
cancelButtonText: 'Vazgeç'
}).then((result) => {
if (result.isConfirmed) {
// WhoWeAre Controller altındaki ilgili silme aksiyonuna yönlendirir
window.location.href = "/WhoWeAre/DeleteWhoWeAreDetail/" + id;
}
})
}
</script>

