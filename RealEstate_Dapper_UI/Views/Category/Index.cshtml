@model List<ResultCategoryDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Admin/Index.cshtml";
}
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="container-fluid pt-4 px-4">
    <div class="row g-4">
<div class="col-12">  
    <div class="bg-light rounded h-100 p-4">
        <h6 class="mb-4">Kategori Listesi</h6>
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Kategori Adı</th>
                        <th scope="col">Durum</th>
                        <th scope="col">Sil</th>
                        <th scope="col">Güncelle</th>
                    </tr>
                </thead>
                <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <th scope="row">@item.CategoryID</th>
                                    <td>@item.CategoryName</td>
                                    <td>@item.CategoryStatus</td>
                                    <td>
                                        <button onclick="deleteCategory(@item.CategoryID)" class="btn btn-outline-danger">Sil</button>
                                    </td>
                                    <td><a href="/Category/UpdateCategory/@item.CategoryID" class="btn btn-outline-success">Güncelle</a></td>
                                </tr>
                            }
                </tbody>
            </table>
                    <a href="/Category/CreateCategory" class="btn btn-outline-info">Yeni Kategori Girişi</a>   
        </div>
    </div>
</div>
</div>
</div>

<script>
    function deleteCategory(id) {
    Swal.fire({
    title: 'Emin misiniz?',
    text: "Bu kategoriyi silmek istediğinize emin misiniz? Bu işlem geri alınamaz!",
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: '#d33',
    cancelButtonColor: '#3085d6',
    confirmButtonText: 'Evet, Sil!',
    cancelButtonText: 'Vazgeç'
    }).then((result) => {
    if (result.isConfirmed) {
    // Onay verilirse ilgili Controller Action'ına yönlendiriyoruz
    window.location.href = "/Category/DeleteCategory/" + id;
    }
    })
    }
</script>