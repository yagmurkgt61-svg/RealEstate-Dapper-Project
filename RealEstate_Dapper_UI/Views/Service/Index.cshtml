@model List<ResultServiceDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Admin/Index.cshtml";
    int count = 0;
}
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="container-fluid pt-4 px-4">
    <div class="row g-4">
        <div class="col-12">
            <div class="bg-light rounded h-100 p-4">
                <h6 class="mb-4">Hizmet Listesi</h6>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th scope="col">#</th>
                                <th scope="col">Hizmet Başlığı</th>
                                <th scope="col">Durum</th>
                                <th scope="col">Sil</th>
                                <th scope="col">Güncelle</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                count++;
                                <tr>
                                    <th scope="row">@count</th>
                                    <td>@item.ServiceName</td>
                                    <td>@item.ServiceStatus</td>
                                    <td>
                                        <button onclick="deleteService(@item.ServiceID)" class="btn btn-outline-danger">Sil</button>
                                    </td>
                                    <td><a href="/Service/UpdateService/@item.ServiceID" class="btn btn-outline-success">Güncelle</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <a href="/Service/CreateService" class="btn btn-outline-info">Yeni Hizmet Girişi</a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function deleteService(id) {
    Swal.fire({
    title: 'Emin misiniz?',
    text: "Bu hizmeti silmek istediğinize emin misiniz? Bu işlem geri alınamaz!",
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: '#d33',
    cancelButtonColor: '#3085d6',
    confirmButtonText: 'Evet, Sil!',
    cancelButtonText: 'Vazgeç'
    }).then((result) => {
    if (result.isConfirmed) {
    // Service Controller altındaki DeleteService metoduna yönlendirir
    window.location.href = "/Service/DeleteService/" + id;
    }
    })
    }
</script>