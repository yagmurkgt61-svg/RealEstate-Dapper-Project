@model RealEstate_Dapper_UI.Dtos.ProductsdbDtos.UpdateProductsdbDto

@{
    ViewData["Title"] = "Ürün Güncelle";
    Layout = "~/Views/Shared/_DataTablesLayout.cshtml";
}

<h2 style="margin-top: 0; margin-bottom: 25px; color: #ffffff;">🔄 Ürün Güncelle</h2>

<form action="/Productsdb/UpdateProductsdb" method="post" enctype="multipart/form-data">
    <input type="hidden" name="ProductID" value="@Model?.ProductID" />

    <div class="dt-form-group" style="margin-bottom: 20px;">
        <label for="ProductName" style="color: #a1a5b7; display: block; margin-bottom: 8px;">Ürün Adı</label>
        <input type="text"
               id="ProductName"
               name="ProductName"
               value="@Model?.ProductName"
               class="dt-input"
               style="width: 100%; padding: 10px; background-color: #1e1e2d; border: 1px solid #333; color: #fff; border-radius: 4px;"
               required />
    </div>

    <div class="dt-form-group" style="margin-bottom: 20px;">
        <label for="CategoryID" style="color: #a1a5b7; display: block; margin-bottom: 8px;">Ürün Kategorisi</label>
        <select id="CategoryID"
                name="CategoryID"
                class="dt-input"
                style="width: 100%; padding: 10px; background-color: #1e1e2d; border: 1px solid #333; color: #fff; border-radius: 4px; cursor: pointer;"
                required>
            <option value="" disabled>-- Kategori Seçiniz --</option>
            @if (ViewBag.CategoryList != null)
            {
                @foreach (var item in ViewBag.CategoryList as List<SelectListItem>)
                {
                    if (Model != null && item.Value == Model.CategoryID.ToString())
                    {
                        <option value="@item.Value" selected="selected">@item.Text</option>
                    }
                    else
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                }
            }
        </select>
    </div>

    <div class="dt-form-group" style="margin-bottom: 20px;">
        <label for="UnitInStock" style="color: #a1a5b7; display: block; margin-bottom: 8px;">Stok Miktarı</label>
        <input type="number"
               id="UnitInStock"
               name="UnitInStock"
               value="@Model?.UnitInStock"
               class="dt-input"
               min="0"
               style="width: 100%; padding: 10px; background-color: #1e1e2d; border: 1px solid #333; color: #fff; border-radius: 4px;"
               required />
    </div>

    <div class="dt-form-group" style="margin-bottom: 20px;">
        <label for="Price" style="color: #a1a5b7; display: block; margin-bottom: 8px;">Ürün Fiyatı (KDV'siz)</label>
        <input type="number"
               step="0.01"
               id="Price"
               name="Price"
               value="@Model?.Price.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
               class="dt-input"
               style="width: 100%; padding: 10px; background-color: #1e1e2d; border: 1px solid #333; color: #fff; border-radius: 4px;"
               required />
    </div>

    <div class="dt-form-group" style="margin-bottom: 20px;">
        <label for="PriceVat" style="color: #a1a5b7; display: block; display: flex; justify-content: space-between; margin-bottom: 8px;">
            <span>KDV Dahil Fiyatı</span>
            <span style="font-size: 11px; color: #f1416c;">* Fiyata göre otomatik hesaplanır</span>
        </label>
        <input type="number"
               step="0.01"
               id="PriceVat"
               name="PriceVat"
               value="@Model?.PriceVat.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
               class="dt-input"
               readonly
               style="width: 100%; padding: 10px; background-color: #2b2b3d; border: 1px solid #333; color: #888; border-radius: 4px; cursor: not-allowed;"
               required />
    </div>

    <div class="dt-form-group" style="margin-bottom: 20px;">
        <label for="Details" style="color: #a1a5b7; display: block; margin-bottom: 8px;">Ürün Detayları / Özellikleri</label>
        <textarea id="Details"
                  name="Details"
                  rows="5"
                  class="dt-input"
                  placeholder="Ürünün özelliklerini giriniz..."
                  style="width: 100%; padding: 10px; background-color: #1e1e2d; border: 1px solid #333; color: #fff; border-radius: 4px; resize: vertical; min-height: 120px; font-family: sans-serif;">@Model?.Details</textarea>
    </div>

    <div class="dt-form-group" style="margin-bottom: 25px;">
        <label style="color: #a1a5b7; display: block; margin-bottom: 8px;">Ürün Fotoğrafı</label>

        @if (!string.IsNullOrEmpty(Model?.Image))
        {
            <div style="margin-bottom: 12px; display: flex; align-items: center; gap: 10px;">
                <img id="currentImagePreview" src="@Model.Image" alt="Mevcut Resim" style="max-width: 120px; max-height: 120px; border-radius: 6px; border: 1px solid #333; object-fit: contain;" />
                <span style="color: #626573; font-size: 12px;">(Mevcut Kayıtlı Görsel)</span>
            </div>
        }

        <div style="display: flex; align-items: center; gap: 15px;">
            <input type="file" id="ImageFile" name="ImageFile" accept="image/*" style="display: none;" onchange="updateFileName(this)" />
            <button type="button" onclick="document.getElementById('ImageFile').click()" style="background-color: #2d7ec2; color: #ffffff; border: none; padding: 10px 18px; border-radius: 6px; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; font-weight: 500; font-size: 14px;">
                <span>📤</span> Görsel Seç...
            </button>
            <span id="fileNameDisplay" style="color: #a1a5b7; font-size: 13px;">Dosya seçilmedi</span>
        </div>

        <input type="hidden" name="Image" value="@Model?.Image" />
    </div>

    <div style="margin-top: 30px; display: flex; gap: 12px;">
        <button type="submit" style="background-color: #00ff66; color: #000000; font-size: 14px; font-weight: bold; padding: 12px 24px; cursor: pointer; border: none; border-radius: 6px; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 0 10px rgba(0, 255, 102, 0.2);">
            💾 Ürünü Kaydet
        </button>

        <a href="/Productsdb/Index" style="background-color: #2b2b2b; color: #ffffff; font-size: 14px; padding: 12px 24px; text-decoration: none; border: 1px solid #3a3a3a; border-radius: 6px; display: inline-flex; align-items: center; gap: 8px;">
            ❌ İptal Et / Listeye Dön
        </a>
    </div>

</form>

@section Scripts {
    <script>
        // KDV Otomatik Hesaplama Sistemi
        document.getElementById("Price").addEventListener("input", function () {
            var price = parseFloat(this.value);
            if (!isNaN(price)) {
                var priceVat = price * 1.20;
                document.getElementById("PriceVat").value = priceVat.toFixed(2);
            } else {
                document.getElementById("PriceVat").value = "";
            }
        });

        // Seçilen dosya ismini ekrana yazdırma ve dinamik önizleme fonksiyonu
        function updateFileName(input) {
            var fileName = input.files.length > 0 ? input.files[0].name : "Dosya seçilmedi";
            document.getElementById("fileNameDisplay").innerText = fileName;

            // Yeni seçilen resmi anlık olarak önizlemek için
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    // Eğer önizleme img elementi yoksa oluştur, varsa güncelle
                    var previewImg = document.getElementById("currentImagePreview");
                    if (previewImg) {
                        previewImg.src = e.target.result;
                    } else {
                        // Eğer eski resim yoksa yeni bir img alanı açar
                        var newPreviewDiv = document.createElement("div");
                        newPreviewDiv.style.marginBottom = "12px";
                        newPreviewDiv.innerHTML = '<img id="currentImagePreview" src="' + e.target.result + '" style="max-width: 120px; max-height: 120px; border-radius: 6px; border: 1px solid #333; object-fit: contain;" />';
                        input.parentElement.before(newPreviewDiv);
                    }
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
