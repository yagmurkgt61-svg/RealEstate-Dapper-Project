@model RealEstate_Dapper_UI.Dtos.ProductsdbDtos.CreateProductsdbDto
@{
    ViewData["Title"] = "CreateProductsdb";
    Layout = "~/Views/Shared/_DataTablesLayout.cshtml";
}

<h2 style="margin-top: 0; margin-bottom: 25px; color: #ffffff;">➕ Yeni Ürün Ekle</h2>

<form asp-action="CreateProductsdb" asp-controller="Productsdb" method="post" enctype="multipart/form-data" id="createProductForm">
    <div class="dt-form-group" style="margin-bottom: 20px;">
        <label for="ProductName" style="color: #a1a5b7; display: block; margin-bottom: 8px;">Ürün Adı</label>
        <input type="text"
               id="ProductName"
               name="ProductName"
               class="dt-input"
               placeholder="Ürün adını giriniz..."
               style="width: 100%; padding: 10px; background-color: #141516; border: 1px solid #343536; color: #fff; border-radius: 8px;"
               required />
    </div>

    <div class="dt-form-group" style="margin-bottom: 20px;">
        <label for="UnitInStock" style="color: #a1a5b7; display: block; margin-bottom: 8px;">Stok Miktarı</label>
        <input type="number"
               id="UnitInStock"
               name="UnitInStock"
               class="dt-input"
               placeholder="Stok adedini giriniz..."
               min="0"
               style="width: 100%; padding: 10px; background-color: #141516; border: 1px solid #343536; color: #fff; border-radius: 8px;"
               required />
    </div>

    <div class="dt-form-group" style="margin-bottom: 20px;">
        <label for="Price" style="color: #a1a5b7; display: block; margin-bottom: 8px;">Ürün Fiyatı (KDV'siz)</label>
        <input type="number"
               id="Price"
               name="Price"
               class="dt-input"
               placeholder="0.00"
               step="0.01"
               min="0"
               style="width: 100%; padding: 10px; background-color: #141516; border: 1px solid #343536; color: #fff; border-radius: 8px;"
               required />
    </div>

    <div class="dt-form-group" style="margin-bottom: 20px;">
        <label for="PriceVat" style="color: #a1a5b7; display: block; margin-bottom: 8px;">KDV Dahil Fiyatı</label>
        <input type="number"
               id="PriceVat"
               name="PriceVat"
               class="dt-input"
               placeholder="0.00"
               step="0.01"
               min="0"
               style="width: 100%; padding: 10px; background-color: #141516; border: 1px solid #343536; color: #fff; border-radius: 8px;"
               required />
    </div>

    <div class="dt-form-group" style="margin-bottom: 20px;">
        <label for="CategoryID" style="color: #a1a5b7; display: block; margin-bottom: 8px;">Ürün Kategorisi</label>
        <select id="CategoryID"
                name="CategoryID"
                class="dt-input"
                style="width: 100%; padding: 10px; background-color: #141516; border: 1px solid #343536; color: #fff; border-radius: 8px; cursor: pointer;">
            <option value="" disabled selected>-- Lütfen Bir Kategori Seçiniz --</option>
            @if (ViewBag.CategoryList != null)
            {
                @foreach (var item in ViewBag.CategoryList as List<SelectListItem>)
                {
                    <option value="@item.Value">@item.Text</option>
                }
            }
        </select>
    </div>

    <div class="dt-form-group" style="margin-bottom: 20px;">
        <label for="Details" style="color: #a1a5b7; display: block; margin-bottom: 8px;">Ürün Detayları / Özellikleri</label>
        <textarea id="Details"
                  name="Details"
                  class="dt-input"
                  rows="5"
                  placeholder="Ürünün özelliklerini giriniz..."
                  style="width: 100%; padding: 12px; background-color: #141516; border: 1px solid #343536; color: #fff; border-radius: 8px; font-family: inherit; font-size: 14px; line-height: 1.5; box-sizing: border-box; resize: vertical;"></textarea>
    </div>

    <div class="dt-form-group" style="margin-bottom: 25px;">
        <label style="color: #a1a5b7; display: block; margin-bottom: 8px;">Ürün Fotoğrafı</label>

        <div style="display: flex; gap: 15px; align-items: center; margin-top: 8px;">
            <label class="dt-btn" style="background-color: #337ab7; color: white; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; margin: 0; padding: 10px 20px; border-radius: 8px; font-size: 13px; font-weight: 500; box-shadow: 0 4px 6px rgba(0,0,0,0.2);">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z" />
                    <path d="M7.646 1.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 2.707V11.5a.5.5 0 0 1-1 0V2.707L5.354 4.854a.5.5 0 1 1-.708-.708l3-3z" />
                </svg>
                Görsel Seç...
                <input type="file" name="ImageFile" id="imageInput" accept="image/*" style="display: none;" />
            </label>

            <span id="fileNameDisplay" style="color: #a1a5b7; font-size: 13px; font-weight: 500;">Dosya seçilmedi</span>
        </div>

        <div id="previewContainer" style="display: none; margin-top: 15px; width: 160px; height: 160px; border: 1px solid #343536; border-radius: 10px; padding: 6px; background: #0c0d0e; box-shadow: inset 0 2px 4px rgba(0,0,0,0.5);">
            <img id="imagePreview" src="#" alt="Önizleme" style="width: 100%; height: 100%; object-fit: contain; border-radius: 6px;" />
        </div>
    </div>

    <div style="margin-top: 30px; display: flex; gap: 10px;">
        <button type="submit" class="dt-btn" style="background-color: #00ff66; color: #000000; font-weight: 700; font-size: 14px; padding: 10px 25px; cursor: pointer; border-radius: 8px; border: none; box-shadow: 0 0 12px rgba(0, 255, 102, 0.3);">
            💾 Ürünü Kaydet
        </button>

        <a href="/Productsdb/Index" class="dt-btn" style="background-color: #343536; color: #fff; font-size: 14px; padding: 10px 25px; text-decoration: none; border-radius: 8px; display: inline-block; text-align: center; border: 1px solid rgba(255,255,255,0.05);">
            ❌ İptal Et / Listeye Dön
        </a>
    </div>
</form>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#CategoryID').select2({
                minimumResultsForSearch: -1,
                width: '100%'
            });

            $('#createProductForm').on('submit', function (e) {
                var selectedCategory = $('#CategoryID').val();
                if (!selectedCategory) {
                    alert('Lütfen bir kategori seçiniz!');
                    $('.select2-selection').css('border-color', '#ff3344');
                    e.preventDefault();
                    return false;
                }
            });

            $('#imageInput').on('change', function (e) {
                var file = e.target.files[0];

                if (file) {
                    $('#fileNameDisplay').text(file.name).css('color', '#00ff66');

                    var reader = new FileReader();
                    reader.onload = function (e) {
                        $('#imagePreview').attr('src', e.target.result);
                        $('#previewContainer').css('display', 'block');
                    }
                    reader.readAsDataURL(file);
                } else {
                    $('#fileNameDisplay').text('Dosya seçilmedi').css('color', '#a1a5b7');
                    $('#previewContainer').css('display', 'none');
                }
            });
        });
    </script>
}