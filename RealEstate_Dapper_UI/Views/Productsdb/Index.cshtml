@using RealEstate_Dapper_UI.Dtos.ProductsdbDtos
@model List<ResultProductsdbDto>
@{
    ViewData["Title"] = "Ürün Listesi";
    Layout = "~/Views/Shared/_DataTablesLayout.cshtml";
}

<style>
    /* Özelleştirilmiş Koyu Tema Pop-up (Modal) CSS Düzenlemeleri */
    .custom-modal {
        display: none; 
        position: fixed; 
        z-index: 9999; 
        padding-top: 150px; 
        left: 0;
        top: 0;
        width: 100%; 
        height: 100%; 
        background-color: rgba(0,0,0,0.7); 
        backdrop-filter: blur(3px);
    }

    .custom-modal-content {
        background-color: #1e1e2d; 
        margin: auto;
        padding: 30px;
        border: 1px solid #333;
        width: 400px;
        border-radius: 8px;
        text-align: center;
        box-shadow: 0 5px 15px rgba(0,0,0,0.5);
        animation: animatetop 0.3s;
    }

    @@keyframes animatetop {
        from {top:-300px; opacity:0}
        to {top:0; opacity:1}
    }

    .modal-title {
        color: #ffffff;
        margin-top: 0;
        font-size: 18px;
    }

    .modal-text {
        color: #a1a5b7;
        font-size: 14px;
        margin-bottom: 25px;
    }

    .modal-buttons {
        display: flex;
        justify-content: center;
        gap: 15px;
    }
</style>

<div style="margin-bottom: 20px;">
    <a href="/Productsdb/CreateProductsdb" class="dt-btn dt-btn-success">
        ➕ Yeni Ürün Ekle
    </a>
</div>

<table id="productsdbTable" class="display dark" style="width:100%">
    <thead>
        <tr>
            <th>Ürün ID</th>
            <th>Ürün Adı</th>
            <th>Ürün Kategorisi</th>
            <th>Stok</th>
            <th>Fiyat</th>
            <th>KDV Fiyatı</th>
            <th style="text-align: center; width: 80px;">Sil</th>
            <th style="text-align: center; width: 100px;">Güncelle</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ProductID</td>
                <td>@item.ProductName</td>
                <td>@item.CategoryName</td>
                <td>@item.UnitInStock</td>
                <td>@item.Price.ToString("N2") ₺</td>
                <td>@item.PriceVat.ToString("N2") ₺</td>
                <td style="text-align: center;">
                    <button type="button" class="dt-btn dt-btn-danger" onclick="openDeleteModal(@item.ProductID, '@item.ProductName')">
                        Sil
                    </button>
                </td>
                <td style="text-align: center;">
                    <a href="/Productsdb/UpdateProductsdb?id=@item.ProductID" class="dt-btn dt-btn-warning">
                        Güncelle
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

<div id="deleteModal" class="custom-modal">
    <div class="custom-modal-content">
        <h3 class="modal-title">🚨 Ürünü Sil</h3>
        <p class="modal-text">"<span id="modalProductName" style="color: #f1416c; font-weight: bold;"></span>" ürününü silmek istediğinize emin misiniz?</p>
        <div class="modal-buttons">
            <a id="confirmDeleteBtn" href="#" class="dt-btn dt-btn-danger" style="padding: 10px 20px;">Evet, Sil</a>
            <button type="button" class="dt-btn" style="background-color: #444; color: #fff; padding: 10px 20px;" onclick="closeDeleteModal()">İptal Et</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#productsdbTable').DataTable({
                pageLength: 10,
                // ÇÖZÜM: Sütun sayısı arttığı için Sil ve Güncelle butonları 6 ve 7 oldu
                columnDefs: [
                    { orderable: false, targets: [6, 7] }
                ],
                language: {
                    search: "Aramak:",
                    lengthMenu: "_MENU_ &nbsp;sayfa başına girişler",
                    info: "Gösteriliyor _START_ ile _END_ arası toplam _TOTAL_ giriş",
                    infoEmpty: "Kayıt yok",
                    zeroRecords: "Eşleşen kayıt bulunamadı",
                    paginate: {
                        next: "»",
                        previous: "«"
                    }
                }
            });
        });

        function openDeleteModal(id, productName) {
            // ÇÖZÜM: Element ID'si modalProductName olarak senkronize edildi
            document.getElementById("modalProductName").innerText = productName;
            
            document.getElementById("confirmDeleteBtn").href = "/Productsdb/DeleteProductsdb?id=" + id;
            document.getElementById("deleteModal").style.display = "block";
        }

        function closeDeleteModal() {
            document.getElementById("deleteModal").style.display = "none";
        }

        window.onclick = function(event) {
            var modal = document.getElementById("deleteModal");
            if (event.target == modal) {
                modal.style.display = "none";
            }
        }
    </script>
}