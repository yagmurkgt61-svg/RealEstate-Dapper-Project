@model List<ResultPopularLocationDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Admin/Index.cshtml";
    int count = 0;
}
<style>
    img{
        border-radius:50%;
    }
</style>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="container-fluid pt-4 px-4">
    <div class="row g-4">
        <div class="col-12">
            <div class="bg-light rounded h-100 p-4">
                <h6 class="mb-4">Popüler Lokasyonlar Listesi</h6>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th scope="col">#</th>
                                <th scope="col">Şehir Adı</th>
                                <th scope="col">Sil</th>
                                <th scope="col">Güncelle</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                count++;
                                <tr>
                                    <th scope="row">@count</th>
                                    <td><img src="@item.ImageUrl" height="50" width="50"/>@item.CityName</td>
                                    <td>
                                        <button onclick="deleteLocation(@item.LocationID)" class="btn btn-outline-danger">Sil</button>
                                    </td>
                                    <td><a href="/PopularLocation/UpdatePopularLocation/@item.LocationID" class="btn btn-outline-success">Güncelle</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <a href="/PopularLocation/CreatePopularLocation" class="btn btn-outline-info">Yeni Lokasyon Girişi</a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function deleteLocation(id) {
    Swal.fire({
    title: 'Emin misiniz?',
    text: "Bu lokasyonu silmek istediğinize emin misiniz? Bu işlem geri alınamaz!",
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: '#d33',
    cancelButtonColor: '#3085d6',
    confirmButtonText: 'Evet, Sil!',
    cancelButtonText: 'Vazgeç'
    }).then((result) => {
    if (result.isConfirmed) {
    // PopularLocation Controller altındaki Delete Action'ına yönlendirir
    window.location.href = "/PopularLocation/DeletePopularLocation/" + id;
    }
    })
    }
</script>